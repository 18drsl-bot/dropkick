function utility:BeginDropkickHook(char)
    if not char then return "character missing" end
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return "humanoid missing" end
    if not self:CheckValidRigType(hum) then return "R15 required for animation" end
    local animator = hum:WaitForChild("Animator", 10)
    if not animator then return "animator missing" end
    return "success"
end


-- Modern visual refresh; preserves original GUI buttons and their behavior.
function utility:ModernizeUI()
    local gui = self.MainUI
    local main = self.Main
    local panel = self.Panel
    if not (gui and main and panel) then return end

    local function corner(obj, pixels)
        local c = obj:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, pixels)
        c.Parent = obj
    end

    local function stroke(obj, color, transparency)
        local s = obj:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
        s.Color = color
        s.Transparency = transparency or 0
        s.Thickness = 1
        s.Parent = obj
    end

    local function gradient(obj, top, bottom)
        local g = obj:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
        g.Color = ColorSequence.new(top, bottom)
        g.Rotation = 90
        g.Parent = obj
    end

    local accent = Color3.fromRGB(109, 93, 252)
    local dark = Color3.fromRGB(19, 21, 33)
    local muted = Color3.fromRGB(29, 32, 48)
    local textColor = Color3.fromRGB(238, 241, 255)

    gui.DisplayOrder = 20
    main.Size = UDim2.fromOffset(56, 56)
    self.GearButton.Size = UDim2.fromOffset(56, 56)
    self.GearButton.BackgroundColor3 = dark
    corner(self.GearButton, 16)
    stroke(self.GearButton, accent, 0.1)
    gradient(self.GearButton, Color3.fromRGB(43, 40, 82), dark)

    panel.BackgroundColor3 = dark
    panel.Position = UDim2.new(0, 0, 1, 10)
    corner(panel, 16)
    stroke(panel, Color3.fromRGB(76, 79, 113), 0.15)
    gradient(panel, Color3.fromRGB(30, 32, 51), Color3.fromRGB(17, 19, 30))

    local header = Instance.new("TextLabel")
    header.Name = "ModernHeader"
    header.LayoutOrder = 0
    header.Size = UDim2.new(1, 0, 0, 38)
    header.BackgroundTransparency = 1
    header.Font = Enum.Font.GothamBold
    header.Text = "DROP KICK   •   CONTROLS"
    header.TextColor3 = textColor
    header.TextSize = 12
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Parent = panel

    for _, button in ipairs({self.ClickButton, self.KeyButton, self.UIButton}) do
        button.BackgroundColor3 = muted
        button.TextColor3 = textColor
        button.Font = Enum.Font.GothamSemibold
        button.TextSize = 13
        corner(button, 10)
        stroke(button, Color3.fromRGB(70, 73, 101), 0.45)
        button.MouseEnter:Connect(function()
            self.TweenService:Create(button, TweenInfo.new(0.12), {
                TextColor3 = Color3.fromRGB(198, 192, 255)
            }):Play()
        end)
        button.MouseLeave:Connect(function()
            self.TweenService:Create(button, TweenInfo.new(0.12), {
                TextColor3 = textColor
            }):Play()
        end)
    end

    self.KeyConfig.BackgroundColor3 = muted
    corner(self.KeyConfig, 10)
    self.KeyBox.BackgroundColor3 = Color3.fromRGB(56, 50, 103)
    corner(self.KeyBox, 8)

    self.ActionButton.BackgroundColor3 = accent
    self.ActionButton.Text = "⚡ DROP KICK"
    self.ActionButton.Font = Enum.Font.GothamBold
    self.ActionButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    corner(self.ActionButton, 13)
    stroke(self.ActionButton, Color3.fromRGB(170, 158, 255), 0.15)
    gradient(self.ActionButton, Color3.fromRGB(126, 108, 255), Color3.fromRGB(82, 66, 212))
    self.ActionButton.Size = UDim2.fromOffset(148, 46)

    -- Keep the original selection highlighting, but use the new palette.
    self:UpdateUI()
end

function utility:Initialize()
    self.LocalPlayer = self.Players.LocalPlayer
    if not self.LocalPlayer then
        warn("Dropkick UI must run in a client LocalScript")
        return
    end

    -- Create UI first: character loading must never block the menu.
    self:CreateUI()
    self:ModernizeUI()
    self:MouseDetection()
    self:StartKeyDetection()

    local function onCharacter(character)
        self.character = character
        task.spawn(function()
            local result = self:BeginDropkickHook(character)
            if result ~= "success" then
                warn("Dropkick animation unavailable: " .. result)
            end
        end)
    end

    self.charadded = self.LocalPlayer.CharacterAdded:Connect(onCharacter)
    if self.LocalPlayer.Character then onCharacter(self.LocalPlayer.Character) end
    print("Dropkick UI loaded")
end


