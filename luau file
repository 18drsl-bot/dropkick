-- Place this Script in ServerScriptService in a game you own.
-- Works with DropkickController.client.lua in StarterPlayerScripts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remote = ReplicatedStorage:FindFirstChild("DropkickFling")
if not remote then
    remote = Instance.new("RemoteEvent")
    remote.Name = "DropkickFling"
    remote.Parent = ReplicatedStorage
end

local FLING_POWER = 90        -- Horizontal velocity change
local UPWARD_POWER = 40      -- Vertical velocity change
local HIT_RADIUS = 7         -- Studs from the kicker
local HIT_DELAY = 0.18       -- Seconds after animation starts
local COOLDOWN = 1.2         -- Seconds between kicks
local FACING_THRESHOLD = 0.25

local lastKick = {}

Players.PlayerRemoving:Connect(function(player)
    lastKick[player] = nil
end)

remote.OnServerEvent:Connect(function(player)
    local now = os.clock()
    if lastKick[player] and now - lastKick[player] < COOLDOWN then
        return
    end

    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not humanoid or humanoid.Health <= 0 then
        return
    end

    -- Cooldown is tracked on the server, not the client.
    lastKick[player] = now
    task.wait(HIT_DELAY)

    if player.Character ~= character or not root.Parent or humanoid.Health <= 0 then
        return
    end

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            local targetCharacter = target.Character
            local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
            local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")

            if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
                local offset = targetRoot.Position - root.Position
                local horizontalOffset = Vector3.new(offset.X, 0, offset.Z)

                if offset.Magnitude <= HIT_RADIUS and horizontalOffset.Magnitude > 0.1 then
                    local direction = horizontalOffset.Unit
                    local forward = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
                    if forward.Magnitude > 0.1 and forward.Unit:Dot(direction) > FACING_THRESHOLD then
                        local deltaVelocity = direction * FLING_POWER + Vector3.new(0, UPWARD_POWER, 0)
                        -- Give the server physics authority briefly for reliable knockback.
                        local hasServerOwnership = pcall(function()
                            targetRoot:SetNetworkOwner(nil)
                        end)
                        if targetRoot.Parent then
                            targetRoot:ApplyImpulse(deltaVelocity * targetRoot.AssemblyMass)
                        end
                        if hasServerOwnership then
                            task.delay(0.4, function()
                                if targetRoot.Parent and not targetRoot.Anchored then
                                    pcall(function()
                                        targetRoot:SetNetworkOwnershipAuto()
                                    end)
                                end
                            end)
                        end
                    end
                end
            end
        end
    end
end)
