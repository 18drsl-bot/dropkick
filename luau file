-- ServerScriptService > DropkickServer (Script)
-- This is for an experience you own in Roblox Studio.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remote = ReplicatedStorage:FindFirstChild("DropkickHit")
if not remote then
    remote = Instance.new("RemoteEvent")
    remote.Name = "DropkickHit"
    remote.Parent = ReplicatedStorage
end

local COOLDOWN = 0.8
local MAX_DISTANCE = 7
local FORWARD_SPEED = 110
local UPWARD_SPEED = 35
local lastKick = {}

remote.OnServerEvent:Connect(function(player)
    local now = os.clock()
    if lastKick[player] and now - lastKick[player] < COOLDOWN then return end

    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root then return end
    lastKick[player] = now

    local facing = root.CFrame.LookVector
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    local hitbox = root.CFrame * CFrame.new(0, 0, -3)
    local parts = workspace:GetPartBoundsInBox(hitbox, Vector3.new(5, 5, 5), params)
    local alreadyHit = {}

    for _, part in ipairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and not alreadyHit[model] then
            alreadyHit[model] = true
            local targetHumanoid = model:FindFirstChildOfClass("Humanoid")
            local targetRoot = model:FindFirstChild("HumanoidRootPart")
            if targetHumanoid and targetHumanoid.Health > 0 and targetRoot then
                local offset = targetRoot.Position - root.Position
                local distance = offset.Magnitude
                if distance > 0.1 and distance <= MAX_DISTANCE
                    and facing:Dot(offset.Unit) >= 0.3 then
                    local impulse = (facing * FORWARD_SPEED + Vector3.new(0, UPWARD_SPEED, 0))
                        * targetRoot.AssemblyMass
                    targetRoot:ApplyImpulse(impulse)
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    lastKick[player] = nil
end)

